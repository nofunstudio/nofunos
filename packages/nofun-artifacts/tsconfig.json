{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "preferSchemaOverJson": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ],
    "paths": {
      "@nofun/artifacts": ["./src/runtime/index.ts"]
    }
  },
  "include": ["src", "examples"]
}
